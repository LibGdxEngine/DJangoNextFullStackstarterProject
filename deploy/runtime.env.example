# Bootstrap copies this to root-owned runtime.env (0600); fill all blank secrets.
# The controller supplies BACKEND_IMAGE and FRONTEND_IMAGE as immutable digests.
COMPOSE_PROJECT_NAME=mobser-test
EDGE_NETWORK=mobser_test_edge
EDGE_ALIAS=mobser-test-gateway
GATEWAY_PORT=18080
DB_NAME=mobser_test
DB_USER=mobser_test
DB_PASSWORD=
SECRET_KEY=
OTP_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://test.example.com
ALLOWED_HOSTS=test.example.com,localhost,backend
CORS_ALLOWED_ORIGINS=https://test.example.com
CSRF_TRUSTED_ORIGINS=https://test.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
HIREAGENTS_BASE_URL=http://127.0.0.1:9
HIREAGENTS_AUTH_CHANNEL_ID=
HIREAGENTS_AUTH_API_KEY=
HIREAGENTS_SUPPORT_CHANNEL_ID=
HIREAGENTS_SUPPORT_API_KEY=
# Generate a distinct random value for each webhook key and signing secret.
HIREAGENTS_AUTH_WEBHOOK_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_SIGNING_SECRET=
HIREAGENTS_SUPPORT_WEBHOOK_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_SIGNING_SECRET=
# Browser agent (celery_browser). Without a key, agent runs fail with a clear error.
OPENROUTER_API_KEY=
MODEL=openrouter:anthropic/claude-sonnet-4.6
MODEL_REASONING_EFFORT=low
# Page gate decision model (empty = off); DECIDER_API_KEY defaults to OPENROUTER_API_KEY.
DECIDER_MODEL=typesafe/jev-1.14
DECIDER_PAGE_GATE=true
DECIDER_API_KEY=
VISION=true
BROWSER_SNAPSHOT=inline
BROWSER_FAST_WAITS=true
# The worker refuses to browse unless its exit IP is pinned (STATIC_IP + PROXY_*) or this is true.
ALLOW_ANY_EXIT_IP=true
ALLOWED_DOMAINS=
# web_search uses the Brave Search API with this key; without it a search engine tab is used.
BRAVE_SEARCH_API_KEY=
SEARCH_LANGUAGE=en-US
SEARCH_COUNTRY=
# Per-host pacing of page loads and fetches, the in-run fetch cache, fetch_many parallelism.
BROWSER_THROTTLE_START_S=1.0
BROWSER_THROTTLE_MIN_S=0.3
BROWSER_THROTTLE_MAX_S=12
BROWSER_THROTTLE_TARGET_CONCURRENCY=1.5
BROWSER_HTTP_CACHE_TTL_S=300
FETCH_MAX_PARALLEL=6
