# Django Production Environment Variables
DJANGO_SETTINGS_MODULE=core.settings.prod
SECRET_KEY=generate-a-secure-random-secret-key-for-production-here
OTP_SECRET=generate-a-secure-random-otp-secret-key-for-production
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL Production Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=prod_db
DB_USER=prod_user
DB_PASSWORD=secure-database-password-change-me

# Redis and Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Scheduled jobs (Celery Beat) retention windows; cadences are editable in Django admin
VERIFICATION_CHALLENGE_RETENTION_DAYS=1
EXPIRED_TOKEN_RETENTION_DAYS=1
INVITATION_EXPIRY_DAYS=7
TEMP_UPLOAD_RETENTION_HOURS=24
SUBSCRIPTION_PAST_DUE_GRACE_HOURS=24
SCHEDULED_REPORT_PERIOD_DAYS=7

# Legacy public API base; browser requests use the same-origin /api/bff boundary.
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# Caddy Domain
DOMAIN_NAME=yourdomain.com

# CORS / CSRF configuration (must match your domain name)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# SSL redirect (set to False if SSL is handled elsewhere, e.g. Cloudflare)
SECURE_SSL_REDIRECT=True

# NextAuth Configuration
NEXTAUTH_SECRET=generate-a-secure-nextauth-secret-key-for-production
NEXTAUTH_URL=https://yourdomain.com
BACKEND_API_URL=http://backend:8000/api
# Private persistent credential vault (separate from Celery and Django cache).
AUTH_SESSION_REDIS_URL=redis://auth_sessions:6379/0

# Google Sign-In (optional; leave blank to hide the Google button)
# Register https://yourdomain.com/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability: runtime exporters stay on private Docker networks.
OTEL_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=0.1
# Set to the deployed commit or release identifier.
APP_VERSION=production
# Linux Docker Engine log location; override when the daemon uses a custom data root.
DOCKER_LOG_ROOT=/var/lib/docker/containers
# Grafana defaults to NEXTAUTH_URL + /observability/ and its origin.
# Change subnet and both addresses together if this subnet is already in use.
# OBSERVABILITY_PROXY_SUBNET=172.30.241.0/29
# OBSERVABILITY_CADDY_IP=172.30.241.2
# OBSERVABILITY_GRAFANA_IP=172.30.241.3

# Rate limiting: independent random secrets (32+ characters) required in production.
# Generate each separately with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_PROXY_TOKEN=
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_MODE=enforce
RATE_LIMIT_BASELINE_MODE=enforce
RATE_LIMIT_ANONYMOUS=60/min
RATE_LIMIT_USER=300/min
RATE_LIMIT_STATUS=30/min
RATE_LIMIT_REDIS_TIMEOUT=0.3
# Optional JSON policy overrides, e.g. {"login_ip":[[20,60]]}
RATE_LIMIT_POLICIES=

# Required for each exposed webhook connection: set an API key, a signing secret, or both.
# Development defaults are rejected at Django/Celery startup.
HIREAGENTS_AUTH_WEBHOOK_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_SIGNING_SECRET=
HIREAGENTS_SUPPORT_WEBHOOK_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_SIGNING_SECRET=

# Developer OCR API. Enable the worker/scanner profile only after configuration.
OCR_ENABLED=false
# Set to ocr_upload:8000 together with OCR_ENABLED=true and COMPOSE_PROFILES=ocr.
OCR_UPLOAD_UPSTREAM=backend:8000
# Add `ocr` to COMPOSE_PROFILES to start dedicated workers and ClamAV.
# COMPOSE_PROFILES=ocr
OCR_MODEL_URL=
# Generate once with cryptography.fernet.Fernet.generate_key(); keep stable.
OCR_PROVIDER_KEY_ENCRYPTION_KEY=
OCR_MODEL_FILE_FIELD=file
# Generate once: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep stable; changing this key changes all derived webhook signing secrets.
OCR_WEBHOOK_SIGNING_KEY=
OCR_WORKER_CONCURRENCY=1
OCR_MAX_PENDING_PER_ORG=5
OCR_MAX_DAILY_BYTES=1500000000
OCR_MAX_STORED_BYTES=1500000000
OCR_MAX_GLOBAL_PENDING=50
OCR_MAX_GLOBAL_STORED_BYTES=7500000000
OCR_RESULT_RETENTION_HOURS=24
