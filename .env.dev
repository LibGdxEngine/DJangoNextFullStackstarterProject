# Django Development Environment Variables
DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=django-insecure-dev-secret-key-template-project-1234
ALLOWED_HOSTS=*

# PostgreSQL Development Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Redis and Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Next.js Development API Endpoint
NEXT_PUBLIC_API_URL=http://localhost/api

# NextAuth Configuration
NEXTAUTH_SECRET=a-secure-nextauth-secret-key-change-this-in-dev
NEXTAUTH_URL=http://localhost
BACKEND_API_URL=http://backend:8000/api

# HireAgents & WhatsApp Messaging Dev Defaults
HIREAGENTS_BASE_URL=https://hireagents.blinksolutions.tech
HIREAGENTS_AUTH_CHANNEL_ID=
HIREAGENTS_AUTH_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_API_KEY=dev-hireagents-auth-webhook-key
HIREAGENTS_AUTH_WEBHOOK_SIGNING_SECRET=
HIREAGENTS_SUPPORT_CHANNEL_ID=
HIREAGENTS_SUPPORT_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_API_KEY=dev-hireagents-support-webhook-key
HIREAGENTS_SUPPORT_WEBHOOK_SIGNING_SECRET=
WHATSAPP_AUTH_TEMPLATE=auth_verification_otp
OTP_SECRET=dev-otp-secret-key-32-chars-minimum-mobser
