# ==============================================================================
# Mobser Platform Environment Variables Template
# Copy this file to .env.dev for local development.
# For production, copy .env.prod.example to .env.prod.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Configuration
# ------------------------------------------------------------------------------
# Dev: core.settings.dev | Prod: core.settings.prod
DJANGO_SETTINGS_MODULE=core.settings.dev

# Production secret key (Must be random, unique, and kept confidential in production)
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-minimum

# Allowed Hosts (Comma-separated in production, e.g. api.yourdomain.com,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Redis & Celery Background Workers
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Scheduled Jobs (Celery Beat) - Retention Windows
# ------------------------------------------------------------------------------
# Cadences live in CELERY_BEAT_SCHEDULE and are retunable from the Django admin
# under "Periodic Tasks". These values control how much data each sweep keeps.
VERIFICATION_CHALLENGE_RETENTION_DAYS=1
EXPIRED_TOKEN_RETENTION_DAYS=1
INVITATION_EXPIRY_DAYS=7
TEMP_UPLOAD_RETENTION_HOURS=24
SUBSCRIPTION_PAST_DUE_GRACE_HOURS=24
SCHEDULED_REPORT_PERIOD_DAYS=7

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Public API URL used by the client browser (e.g. http://localhost/api or https://yourdomain.com/api)
NEXT_PUBLIC_API_URL=http://localhost/api

# Internal Docker network backend API URL used for server-side NextAuth requests
BACKEND_API_URL=http://backend:8000/api

# NextAuth Secret and Canonical URL
NEXTAUTH_SECRET=generate-a-secure-random-secret-for-nextauth
NEXTAUTH_URL=http://localhost
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# Google Sign-In (optional)
# ------------------------------------------------------------------------------
# Leave blank to keep the Google button hidden. Fill both values in and restart to
# enable it: no code changes are required.
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and register
# <NEXTAUTH_URL>/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Reverse Proxy & Domain (Caddy / Production)
# ------------------------------------------------------------------------------
DOMAIN_NAME=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------------
# WhatsApp & Messaging Abstraction (HireAgents Provider)
# ------------------------------------------------------------------------------
HIREAGENTS_BASE_URL=https://hireagents.blinksolutions.tech

# Auth Connection
HIREAGENTS_AUTH_CHANNEL_ID=
HIREAGENTS_AUTH_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_SIGNING_SECRET=

# Support Connection
HIREAGENTS_SUPPORT_CHANNEL_ID=
HIREAGENTS_SUPPORT_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_SIGNING_SECRET=

# Verification Challenge & Templates
WHATSAPP_AUTH_TEMPLATE=auth_verification_otp
OTP_SECRET=replace-with-a-very-secure-random-otp-secret-key-32-chars
