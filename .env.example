# ==============================================================================
# Mobser Platform Environment Variables Template
# Run make init to generate root .env, or copy this file to .env for development.
# For production, copy .env.prod.example to .env.prod.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Configuration
# ------------------------------------------------------------------------------
# Dev: core.settings.dev | Prod: core.settings.prod
DJANGO_SETTINGS_MODULE=core.settings.dev

# Production secret key (Must be random, unique, and kept confidential in production)
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-minimum
DEFAULT_FROM_EMAIL=no-reply@mobser.local

# Allowed Hosts (Comma-separated in production, e.g. api.yourdomain.com,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# For host-run Django, export DB_HOST=localhost (and the published DB_PORT).
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Redis & Celery Background Workers
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Scheduled Jobs (Celery Beat) - Retention Windows
# ------------------------------------------------------------------------------
# Cadences live in CELERY_BEAT_SCHEDULE and are retunable from the Django admin
# under "Periodic Tasks". These values control how much data each sweep keeps.
VERIFICATION_CHALLENGE_RETENTION_DAYS=1
EXPIRED_TOKEN_RETENTION_DAYS=1
INVITATION_EXPIRY_DAYS=7
TEMP_UPLOAD_RETENTION_HOURS=24
SUBSCRIPTION_PAST_DUE_GRACE_HOURS=24
SCHEDULED_REPORT_PERIOD_DAYS=7

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Legacy public API base for external consumers; browser requests use /api/bff.
NEXT_PUBLIC_API_URL=http://localhost/api

# Internal Docker network backend API URL used for server-side NextAuth requests
BACKEND_API_URL=http://backend:8000/api

# Required server-only credential vault; use redis://localhost:6380/0 outside Docker.
# Dedicated private Redis service persists session denial and revocation retries.
AUTH_SESSION_REDIS_URL=redis://auth_sessions:6379/0

# NextAuth Secret and Canonical URL
NEXTAUTH_SECRET=generate-a-secure-random-secret-for-nextauth
NEXTAUTH_URL=http://localhost
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# Google Sign-In (optional)
# ------------------------------------------------------------------------------
# Leave blank to keep the Google button hidden. Fill both values in and restart to
# enable it: no code changes are required.
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and register
# <NEXTAUTH_URL>/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Reverse Proxy & Domain (Caddy / Production)
# ------------------------------------------------------------------------------
DOMAIN_NAME=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------------
# WhatsApp & Messaging Abstraction (HireAgents Provider)
# ------------------------------------------------------------------------------
HIREAGENTS_BASE_URL=https://hireagents.blinksolutions.tech

# Auth Connection
HIREAGENTS_AUTH_CHANNEL_ID=
HIREAGENTS_AUTH_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_SIGNING_SECRET=

# Support Connection
HIREAGENTS_SUPPORT_CHANNEL_ID=
HIREAGENTS_SUPPORT_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_SIGNING_SECRET=

# Verification Challenge & Templates
WHATSAPP_AUTH_TEMPLATE=auth_verification_otp
OTP_SECRET=replace-with-a-very-secure-random-otp-secret-key-32-chars

# ------------------------------------------------------------------------------
# Observability (Docker services enable this; local processes default to disabled)
# ------------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=1.0
APP_VERSION=development
# Linux Docker Engine log location; verify with docker info --format '{{.DockerRootDir}}'
DOCKER_LOG_ROOT=/var/lib/docker/containers
# Optional overrides if the default telemetry proxy subnet conflicts with your host.
# OBSERVABILITY_PROXY_SUBNET=172.30.240.0/29
# OBSERVABILITY_CADDY_IP=172.30.240.2
# OBSERVABILITY_GRAFANA_IP=172.30.240.3
# Override both if the site uses an origin other than http://localhost.
# OBSERVABILITY_ROOT_URL=http://localhost/observability/
# OBSERVABILITY_ROOT_ORIGIN=http://localhost

# Rate limiting: independent random secrets (32+ characters) required in production.
# Generate each separately with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_PROXY_TOKEN=dev-rate-proxy-token-not-for-production
RATE_LIMIT_KEY_SECRET=dev-rate-limit-key-not-for-production
RATE_LIMIT_MODE=enforce
RATE_LIMIT_BASELINE_MODE=enforce
RATE_LIMIT_ANONYMOUS=60/min
RATE_LIMIT_USER=300/min
RATE_LIMIT_STATUS=30/min
RATE_LIMIT_REDIS_TIMEOUT=0.3
# Optional JSON policy overrides, e.g. {"login_ip":[[20,60]]}
RATE_LIMIT_POLICIES=

# Developer OCR API. Enable the worker/scanner profile only after configuration.
OCR_ENABLED=false
# Set to ocr_upload:8000 together with OCR_ENABLED=true and COMPOSE_PROFILES=ocr.
OCR_UPLOAD_UPSTREAM=backend:8000
# Add `ocr` to COMPOSE_PROFILES to start dedicated workers and ClamAV.
# COMPOSE_PROFILES=ocr
OCR_MODEL_URL=
OCR_MODEL_TOKEN=
OCR_MODEL_FILE_FIELD=file
# Generate once: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep stable; changing this key changes all derived webhook signing secrets.
OCR_WEBHOOK_SIGNING_KEY=
OCR_WORKER_CONCURRENCY=1
OCR_MAX_PENDING_PER_ORG=5
OCR_MAX_DAILY_BYTES=1500000000
OCR_MAX_STORED_BYTES=1500000000
OCR_MAX_GLOBAL_PENDING=50
OCR_MAX_GLOBAL_STORED_BYTES=7500000000
OCR_RESULT_RETENTION_HOURS=24
