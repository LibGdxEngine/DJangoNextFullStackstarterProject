{
	admin localhost:2019
	metrics
	servers {
		timeouts {
			read_header 10s
			read_body 5m
		}
	}
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ""
				request>remote_ip delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}

# Only reachable within Docker; no host-published management port.
:9091 {
	handle /metrics {
		metrics
	}
	handle /grafana-metrics {
		rewrite * /observability/metrics
		reverse_proxy {$GRAFANA_PROXY_IP}:3000
	}
	respond 404
}

:80 {
	encode gzip zstd

	request_body /api/v1/ocr/* {
		max_size 151000000
	}

	# Route includes the prefix itself and every asset, API, and WebSocket path.
	@observability path /observability /observability/*
	handle @observability {
		route {
			request_header -X-WEBAUTH-*
			request_header -X-Grafana-*
			forward_auth backend:8000 {
				uri /internal/observability/auth/
				copy_headers X-WEBAUTH-USER
				transport http {
					dial_timeout 2s
					response_header_timeout 5s
				}
			}
			reverse_proxy {$GRAFANA_PROXY_IP}:3000 {
				header_up -Authorization
				header_up -Cookie
				stream_timeout 5m
			}
		}
	}

	respond /internal/observability/auth/ 404

	reverse_proxy /api/auth/* frontend:3000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}
	reverse_proxy /api/bff/* frontend:3000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}
	reverse_proxy /api/v1/ocr/jobs/ {$OCR_UPLOAD_UPSTREAM:backend:8000} {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
		transport http {
			response_header_timeout 330s
		}
	}
	reverse_proxy /api/* backend:8000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}
	reverse_proxy /admin/* backend:8000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}
	reverse_proxy /static/* backend:8000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}
	reverse_proxy /media/* backend:8000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}
	reverse_proxy /* frontend:3000 {
		header_up X-Mobser-Client-IP {remote_host}
		header_up X-Mobser-Proxy-Token {$RATE_LIMIT_PROXY_TOKEN}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ""
				request>remote_ip delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}
